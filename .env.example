# Copy to .env and fill in. Only VAPI_API_KEY is needed to run setup_vapi.py.

# --- Vapi ---------------------------------------------------------------
VAPI_API_KEY=
# Shared secret. If set, webhook requests without a valid x-vapi-secret / x-vapi-signature are rejected.
VAPI_WEBHOOK_SECRET=
# Only for --dynamic-greeting (per-call greeting through assistant-request)
VAPI_ASSISTANT_ID=

# --- Clinic -------------------------------------------------------------
# Which clinic YAML the server uses
CLINIC_CONFIG=configs/examples/general_practice_munich.yaml
# Optional override of transfer_number from the YAML (E.164)
CLINIC_TRANSFER_NUMBER=
# Where bookings.json and call_log.jsonl live
DATA_DIR=data

# --- Models (all optional, defaults shown) ---------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
VOICE_PROVIDER=11labs
VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_MODEL=eleven_multilingual_v2
STT_PROVIDER=deepgram
STT_MODEL=nova-3
STT_LANGUAGE=de

# --- Dashboard ----------------------------------------------------------
# If set, /api/analytics requires "Authorization: Bearer <token>" (the dashboard asks for it)
DASHBOARD_TOKEN=

# --- Notifications for send_summary (all optional) -----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
# Slack incoming webhook, n8n, Make, Zapier...
NOTIFICATION_WEBHOOK_URL=

# --- Server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
